#!/usr/bin/env bash
# commit-msg hook.
# Rejects commits whose subject line violates the project convention:
#   <type>[(scope)][!]: <subject> #<issue>
#   type = feat | fix | refactor | test | docs | chore | style
#
# - "(scope)" and "!" (breaking change) are optional and follow Conventional Commits.
# - The issue number is required, except on agent session branches (copilot/*, claude/*).
# - Subjects that git generates itself (Merge/Revert/fixup!/squash!) are exempt.
#
# Enable with: git config core.hooksPath .githooks
# Applies to every local commit — whether typed by a human or executed by an
# AI agent through the integrated terminal.
# The same rule is re-checked on PRs by .github/workflows/validate-conventions.yml.

set -euo pipefail

msg_file="$1"
# Subject = first non-empty, non-comment line (git strips comment lines itself).
first_line=$(grep -v -E '^[[:space:]]*(#|$)' "$msg_file" | head -n 1 || true)

# Merge/revert/fixup commits generated by git itself are exempt.
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

current_branch=$(git symbolic-ref --short -q HEAD 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

issue_optional=0
case "$current_branch" in
  copilot/*|claude/*) issue_optional=1 ;;
esac

# Validate type prefix (always required)
if ! printf '%s' "$first_line" | grep -Eq '^(feat|fix|refactor|test|docs|chore|style)(\([^)]+\))?!?: [^[:space:]]'; then
  cat >&2 <<EOF
[hook:commit-msg] Commit message violates the project convention.

  First line: $first_line
  Expected:   <type>[(scope)][!]: <subject> #<issue>
  type:       feat | fix | refactor | test | docs | chore | style
  Example:    feat: ユーザーデータモデルを追加 #1

  See .github/instructions/git-conventions.instructions.md for details.
EOF
  exit 1
fi

# Validate issue number (relaxed on agent session branches)
if [ "$issue_optional" -eq 0 ] && ! printf '%s' "$first_line" | grep -Eq '#[0-9]+'; then
  cat >&2 <<EOF
[hook:commit-msg] Commit message is missing the issue number.

  First line:     $first_line
  Current branch: ${current_branch:-unknown}
  Expected:       <type>: <subject> #<issue>
  Example:        fix: 日付計算の境界条件を修正 #5

  Only agent session branches (copilot/*, claude/*) may omit the issue number.
EOF
  exit 1
fi

exit 0
